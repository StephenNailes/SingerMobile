# Copy this file to .env, put in your real URL, then restart Expo with:
#   npx expo start -c
#
# The full URL of singers.php on FreeHostia. setup-check.php prints the exact
# value to paste here. Leave it blank (or delete the line) to go back to the
# offline SQLite directory on the device.
EXPO_PUBLIC_API_URL=https://your-site.freehostia.com/api/singers.php

# Only needed if you set REQUIRE_AUTH to true in singers.php. Must match the
# token in auth.php. Anything with the EXPO_PUBLIC_ prefix is readable inside
# the shipped app, so this is a soft gate, not a secret.
# EXPO_PUBLIC_API_TOKEN=Y29kZXg6cmVzdF9hcGlfdGVzdAo=

# Only if your host blocks PUT/PATCH/DELETE: tunnel them through POST.
# EXPO_PUBLIC_API_METHOD_OVERRIDE=1
